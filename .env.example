HUGINN_DATABASE_URL=postgresql://localhost:5432/huginn
HUGINN_MANAGEMENT_DATABASE_URL=postgresql://localhost:5432/huginn_management
# Value is the `key` field inside `window.AlgoliaOpts`, embedded in the page
# source of https://www.ycombinator.com/companies. It's a public, search-only
# key shipped to every browser that loads that page, not a secret to request
# from anyone.
HUGINN_YC_ALGOLIA_API_KEY=
# Requires registering a real OpenCorporates account and generating an API
# token from the account page (https://opencorporates.com/), unlike YC's
# public key above: every call is rejected without one.
HUGINN_OPENCORPORATES_API_TOKEN=
