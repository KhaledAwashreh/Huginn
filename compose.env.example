# Private configuration: generate .env with scripts/configure-compose.py.
# Keep these values stable across restarts. Generated password is URL-safe hex.
POSTGRES_PASSWORD=
HUGINN_LIFECYCLE_PROOF_KEY=
HUGINN_IMAGE=huginn-app:local
HUGINN_HOST_PORT=8080
HUGINN_MAILBOX_PORT=8026
HUGINN_WEB_ORIGIN=http://localhost:8080
HUGINN_MANAGEMENT_ENVIRONMENT=local
HUGINN_SMTP_HOST=mailpit
HUGINN_SMTP_PORT=1025
HUGINN_SMTP_TLS=none
HUGINN_SMTP_USERNAME=
HUGINN_SMTP_PASSWORD=
HUGINN_SMTP_SENDER=no-reply@huginn.local
HUGINN_YC_ALGOLIA_API_KEY=
HUGINN_OPENCORPORATES_API_TOKEN=
# Seeded on first deployment; later runs preserve DB credentials and disablement.
HUGINN_BOOTSTRAP_ADMIN_USERNAME=Khaled
HUGINN_BOOTSTRAP_ADMIN_EMAIL=khaled@huginn.local
HUGINN_BOOTSTRAP_ADMIN_PASSWORD=
# Second founder, with an independently generated private password.
HUGINN_BOOTSTRAP_SECOND_ADMIN_USERNAME=Craig
HUGINN_BOOTSTRAP_SECOND_ADMIN_EMAIL=craig@huginn.local
HUGINN_BOOTSTRAP_SECOND_ADMIN_PASSWORD=

# Optional hosted HTTPS. Leave COMPOSE_PROFILES empty for local HTTP.
COMPOSE_PROFILES=
HUGINN_BIND_ADDRESS=127.0.0.1
HUGINN_DOMAIN=huginn.live
HUGINN_DOMAIN_ALIAS=www.huginn.live
HUGINN_ACME_EMAIL=
HUGINN_ACME_ENVIRONMENT=production
# Only the designated proxy is trusted. HTTPS requires an explicit unused /29,
# for example 172.30.255.0/29. Leave blank for automatic local network allocation.
HUGINN_PROXY_IP=172.30.255.2
HUGINN_INGRESS_SUBNET=
