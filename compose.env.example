# Private configuration: generate .env with scripts/configure-compose.py.
# Keep these values stable across restarts. Generated password is URL-safe hex.
POSTGRES_PASSWORD=
HUGINN_LIFECYCLE_PROOF_KEY=
HUGINN_HOST_PORT=8080
HUGINN_MAILBOX_PORT=8026
HUGINN_WEB_ORIGIN=http://localhost:8080
HUGINN_MANAGEMENT_ENVIRONMENT=local
HUGINN_SMTP_HOST=mailpit
HUGINN_SMTP_PORT=1025
HUGINN_SMTP_TLS=none
HUGINN_SMTP_USERNAME=
HUGINN_SMTP_PASSWORD=
HUGINN_SMTP_SENDER=no-reply@huginn.local
HUGINN_YC_ALGOLIA_API_KEY=
HUGINN_OPENCORPORATES_API_TOKEN=
# Seeded on first deployment; later runs preserve DB credentials and disablement.
HUGINN_BOOTSTRAP_ADMIN_USERNAME=huginn-admin
HUGINN_BOOTSTRAP_ADMIN_EMAIL=admin@huginn.local
HUGINN_BOOTSTRAP_ADMIN_PASSWORD=
